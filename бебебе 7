result = []

def divider(a, b):
    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):
        raise TypeError("Передан некорректный тип данных (ожидалось число)")
    if a < b:
        raise ValueError("Первое число меньше второго (a < b)")
    if b > 100:
        raise IndexError("Второе число больше 100 (b > 100)")
    return a / b


data = {10: 2, 2: 5, "123": 4, 18: 0, (): 15, 8: 4}

for key in data:
    try:
        res = divider(key, data[key])
        result.append(res)
    except Exception as e:
        # Перехват и вывод всех типов исключений в консоль
        print(f"Перехвачено исключение: {type(e).__name__} -> {e}")

print("\nИтоговый результат работы:", result)
